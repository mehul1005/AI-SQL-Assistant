<Window x:Class="AiSqlAssistant.Client.AuditLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enterprise Audit Logs" Height="600" Width="1000" WindowStartupLocation="CenterOwner" Background="#F3F4F6">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="System Audit Trail" FontSize="20" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,15"/>

        <DataGrid x:Name="LogsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="White" RowBackground="#F9FAFB" AlternatingRowBackground="White" 
                  ColumnHeaderHeight="35" RowHeight="35" FontSize="13" BorderBrush="#D1D5DB" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="140"/>

                <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="120" FontWeight="SemiBold" Foreground="#2563EB"/>

                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Risk" Binding="{Binding RiskLevel}" Width="80"/>
                <DataGridTextColumn Header="Duration (ms)" Binding="{Binding ExecutionDurationMs}" Width="100"/>
                <DataGridTextColumn Header="Prompt" Binding="{Binding UserPrompt}" Width="200"/>
                <DataGridTextColumn Header="SQL" Binding="{Binding GeneratedSql}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>