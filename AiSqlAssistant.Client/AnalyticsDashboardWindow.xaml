<Window x:Class="AiSqlAssistant.Client.AnalyticsDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enterprise Analytics Dashboard" Height="450" Width="800" WindowStartupLocation="CenterOwner" Background="#F3F4F6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="System Analytics &amp; Security Metrics" FontSize="22" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,20"/>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
            <Border Background="White" CornerRadius="8" Padding="15" Margin="5" BorderBrush="#D1D5DB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TOTAL QUERIES" FontSize="12" FontWeight="Bold" Foreground="#6B7280"/>
                    <TextBlock x:Name="TxtTotal" Text="0" FontSize="32" FontWeight="Bold" Foreground="#3B82F6" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="5" BorderBrush="#D1D5DB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="BLOCKED THREATS" FontSize="12" FontWeight="Bold" Foreground="#6B7280"/>
                    <TextBlock x:Name="TxtBlocked" Text="0" FontSize="32" FontWeight="Bold" Foreground="#EF4444" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="5" BorderBrush="#D1D5DB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="CRITICAL RISKS" FontSize="12" FontWeight="Bold" Foreground="#6B7280"/>
                    <TextBlock x:Name="TxtCritical" Text="0" FontSize="32" FontWeight="Bold" Foreground="#F59E0B" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="5" BorderBrush="#D1D5DB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="AVG DURATION (ms)" FontSize="12" FontWeight="Bold" Foreground="#6B7280"/>
                    <TextBlock x:Name="TxtAvgTime" Text="0ms" FontSize="32" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20" Margin="5" BorderBrush="#D1D5DB" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Top System Users" FontSize="16" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,15"/>

                <ItemsControl x:Name="TopUsersChart" Grid.Row="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding UserName}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#4B5563"/>

                                <ProgressBar Grid.Column="1" Value="{Binding QueryCount, Mode=OneWay}" Maximum="{Binding MaxCount}" Height="20" Background="#F3F4F6" Foreground="#6366F1" BorderThickness="0"/>

                                <TextBlock Grid.Column="2" Text="{Binding QueryCount}" TextAlignment="Right" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#1F2937"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</Window>