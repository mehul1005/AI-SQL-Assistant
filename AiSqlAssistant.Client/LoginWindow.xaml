<Window x:Class="AiSqlAssistant.Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI SQL Assistant - Login" Height="400" Width="350" 
        WindowStartupLocation="CenterScreen" Background="#F3F4F6" ResizeMode="NoResize">
    <Border Background="White" CornerRadius="10" Margin="20" Padding="20" BorderBrush="#D1D5DB" BorderThickness="1">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="🔒 Secure Access" FontSize="22" FontWeight="Bold" Foreground="#1F2937" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="Enter your credentials to continue" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <TextBlock Text="Username" FontSize="12" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtUsername" Height="35" Padding="5" Margin="0,0,0,15" FontSize="14"/>

            <TextBlock Text="Password" FontSize="12" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtPassword" Height="35" Padding="5" Margin="0,0,0,20" FontSize="14"/>

            <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>

            <Button x:Name="BtnLogin" Content="Sign In" Height="40" Background="#3B82F6" Foreground="White" FontSize="14" FontWeight="Bold" Click="BtnLogin_Click"/>

        </StackPanel>
    </Border>
</Window>