<Window x:Class="AiSqlAssistant.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI SQL Assistant V6 - Risk Analyzer" Height="750" Width="1000" WindowStartupLocation="CenterScreen" Background="#F3F4F6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PromptTextBox" Grid.Column="0" Height="50" TextWrapping="Wrap" AcceptsReturn="True" 
                     Padding="10" FontSize="14" Margin="0,0,15,0"
                     Text="Show me all applications assigned to PC."/>

            <Button x:Name="GenerateButton" Grid.Column="1" Content="1. Generate SQL" Width="160" Height="50" 
                    Background="#3B82F6" Foreground="White" FontWeight="Bold" FontSize="14" Click="GenerateButton_Click" Margin="0,0,10,0"/>

            <Button x:Name="ViewLogsButton" Grid.Column="2" Content="View Audit Logs" Width="130" Height="50" 
                    Background="#4B5563" Foreground="White" FontWeight="Bold" FontSize="13" Click="ViewLogsButton_Click"/>
        </Grid>

        <Border x:Name="RiskDashboard" Grid.Row="1" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,15" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Risk Level: " FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                    <Border x:Name="RiskBadge" Background="#10B981" CornerRadius="3" Padding="8,2">
                        <TextBlock x:Name="RiskText" Text="LOW" Foreground="White" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Operation: " FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OperationText" Text="SELECT" Foreground="#4B5563" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Tables: " FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TablesText" Text="Applications" Foreground="#4B5563" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="Review &amp; Edit Generated SQL:" FontWeight="SemiBold" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <Button x:Name="ExecuteButton" Content="2. Approve &amp; Execute" Width="160" Height="35" 
                    Background="#10B981" Foreground="Black" FontWeight="Bold" FontSize="13" Click="ExecuteButton_Click" IsEnabled="False"/>
        </StackPanel>

        <Border Grid.Row="3" Background="#1E1E1E" CornerRadius="5" Padding="2" Margin="0,0,0,15">
            <TextBox x:Name="OutputTextBox" Background="Transparent" Foreground="#D4D4D4" FontFamily="Consolas" 
                     FontSize="14" IsReadOnly="False" TextWrapping="Wrap" BorderThickness="0" Padding="10" MinHeight="80"
                     Text="-- Generated SQL will appear here for review..."/>
        </Border>

        <DataGrid x:Name="ResultsDataGrid" Grid.Row="4" AutoGenerateColumns="True" IsReadOnly="True" 
                  Background="White" RowBackground="#F9FAFB" AlternatingRowBackground="White" 
                  ColumnHeaderHeight="35" RowHeight="30" FontSize="14" BorderBrush="#D1D5DB" BorderThickness="1"/>
    </Grid>
</Window>